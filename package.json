{
  "name": "longmont-ai",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run release:check && tsc -b && vite build && npm run release:check",
    "lint": "eslint .",
    "test": "node scripts/test-suite.mjs",
    "test:suite-wiring": "node --test scripts/tests/test-suite-wiring.test.mjs",
    "test:site-behavior": "node --experimental-strip-types --test scripts/tests/site-behavior.test.mjs",
    "security:commit": "scripts/security-commit-review.sh staged",
    "security:push": "scripts/security-commit-review.sh push",
    "security:review": "scripts/security-commit-review.sh all",
    "security:agent-review": "codex exec --ephemeral --sandbox read-only 'Use $security-commit-review to review the current local changes for security vulnerabilities only. Do not edit files or mutate the repository. Prioritize exploitable findings with exact file references and minimal fixes.'",
    "security:remediate": "SECURITY_COMMIT_AUTO_FIX=1 scripts/security-commit-review.sh all",
    "security:test-chain": "node scripts/tests/security-review-chain.test.mjs",
    "security:test-runtime": "node scripts/tests/runtime-security-headers.mjs",
    "test:loop-push": "node scripts/tests/loop-push-contract.test.mjs",
    "security:test": "npm run security:test-chain && npm run security:test-runtime",
    "verify:local": "bash scripts/local-ci.sh",
    "hooks:install": "scripts/install-security-hooks.sh",
    "content:check-assets": "node scripts/check-content-assets.js",
    "release:stage": "node scripts/stage-scheduled-release.mjs --manifest",
    "release:check": "node scripts/stage-scheduled-release.mjs --check",
    "release:inventory": "node scripts/stage-scheduled-release.mjs --inventory",
    "release:self-test": "node scripts/lib/scheduled-release-self-test.mjs",
    "test:scheduled-stage": "node --test scripts/tests/scheduled-stage-rollover.test.mjs",
    "test:scheduled-api": "node --test scripts/tests/scheduled-api-contract.test.mjs",
    "test:scheduled-artifact": "node --test scripts/tests/scheduled-artifact-contract.test.mjs",
    "test:scheduled-release": "node --test scripts/tests/scheduled-*.test.mjs",
    "site:update:preflight": "node scripts/update-site-preflight.mjs",
    "test:update-site": "node scripts/tests/update-site-preflight.test.mjs",
    "model-watch:update": "node scripts/update-model-watch.mjs",
    "test:model-watch": "node scripts/tests/model-watch-contract.test.mjs",
    "newsletter:check": "node scripts/newsletter-setup-check.mjs",
    "newsletter:draft": "node scripts/generate-newsletter-draft.mjs",
    "newsletter:setup-listmonk": "node scripts/setup-listmonk-newsletter.mjs",
    "test:newsletter": "node --test scripts/tests/newsletter-*.test.mjs",
    "test:mobile-contract": "node scripts/tests/mobile-audit-contract.test.mjs",
    "test:flows-contract": "node scripts/tests/flow-lanes-contract.test.mjs",
    "test:tools-matrix": "node scripts/tests/tools-matrix-contract.test.mjs",
    "test:space-background": "node --experimental-strip-types --test scripts/tests/space-background.test.mjs",
    "audit:mobile": "bash scripts/run-mobile-browser-audit.sh",
    "test:mobile": "bash scripts/run-mobile-audit.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "svelte": "^5.56.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
